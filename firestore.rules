rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Documentos pastorales de la congregación
    match /congregation/{congId}/documentos/{docId} {
      // Cualquier usuario autenticado puede leer
      allow read: if request.auth != null;

      // Solo usuarios autenticados pueden escribir (subir, editar)
      // La validación de rol (elder/admin) se hace en el cliente;
      // para mayor seguridad añade custom claims si lo necesitas
      allow create, update: if request.auth != null;

      // Solo borrar si estás autenticado
      allow delete: if request.auth != null;
    }

    // Categorías de la congregación
    match /congregation/{congId}/documento_categorias/{catId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Módulo de Territorios ──
    // Validación de rol (responsable/elder/admin) en el cliente, igual que
    // Documentos. Los campos sensibles (direcciones "No visitar", notas) viajan
    // cifrados con la master key de la congregación. Mejora futura: acotar por
    // pertenencia a la congregación vía custom claims.
    match /congregation/{congId}/territory_zones/{id} {
      allow read, write: if request.auth != null;
    }
    match /congregation/{congId}/territories/{id} {
      allow read, write: if request.auth != null;
    }
    match /congregation/{congId}/territory_assignments/{id} {
      allow read, write: if request.auth != null;
    }
    match /congregation/{congId}/territory_locations/{id} {
      allow read, write: if request.auth != null;
    }
    match /congregation/{congId}/territory_campaigns/{id} {
      allow read, write: if request.auth != null;
    }
    match /congregation/{congId}/territory_requests/{id} {
      allow read, write: if request.auth != null;
    }
    match /congregation/{congId}/territory_notices/{id} {
      allow read, write: if request.auth != null;
    }
    match /congregation/{congId}/territory_tags/{id} {
      allow read, write: if request.auth != null;
    }
    match /congregation/{congId}/territory_settings/{id} {
      allow read, write: if request.auth != null;
    }

    // ── Enlaces públicos de territorio ────────────────────────────────────
    // ÚNICA colección del proyecto legible SIN estar autenticado: es lo que
    // permite que un invitado (p. ej. el superintendente de circuito) abra un
    // territorio compartido sin tener cuenta.
    //
    // Qué protege el contenido:
    //  - El ID del documento es un token aleatorio de 192 bits: no se puede
    //    adivinar, y `list` exige sesión, así que nadie puede enumerarlos.
    //  - El campo `payload` va cifrado con AES-GCM y una clave que SOLO viaja
    //    en el fragmento (#) de la URL. Ni Firestore ni nadie con acceso a la
    //    base de datos puede leer el territorio.
    //
    // La CADUCIDAD la decide esta regla, no el código de la app: el enlace
    // vale mientras su asignación siga abierta (`returnedAt` nulo). Así el
    // mismo batch que entrega el territorio invalida el enlace de forma
    // atómica, y no hay que acordarse de revocar en los cinco caminos que
    // cierran o borran una asignación (entregar, borrar asignación, finalizar
    // campaña, borrar campaña y borrar territorio). Si la asignación deja de
    // existir, `exists()` es falso y también deniega.
    //
    // OJO: esto asume que el inicio de sesión ANÓNIMO está deshabilitado en la
    // consola de Firebase. Si se habilitara, cualquiera podría autenticarse y
    // leerlo todo — no solo esta colección, sino todas las de arriba.
    match /congregation/{congId}/territory_shares/{token} {
      function assignmentPath() {
        return /databases/$(database)/documents/congregation/$(congId)/territory_assignments/$(resource.data.assignmentId);
      }

      function assignmentOpen() {
        return exists(assignmentPath())
          && get(assignmentPath()).data.get('returnedAt', null) == null;
      }

      // Un enlace puede no estar atado a ninguna asignación: es el caso de un
      // responsable que comparte un territorio sin asignar (para dárselo por
      // WhatsApp a alguien sin cuenta). Entonces solo lo limitan la caducidad
      // y la revocación.
      function assignmentStillValid() {
        return resource.data.get('assignmentId', null) == null
          || assignmentOpen();
      }

      // Tope de vida DURO, comprobado en el servidor. Antes no existía: un
      // enlace atado a una asignación que nadie llegaba a entregar seguía
      // vivo indefinidamente. `.get('expiresAt', ...)` con una fecha ya
      // pasada falla en cerrado si el campo faltara (enlaces antiguos).
      function notExpired() {
        return request.time < resource.data.get('expiresAt', timestamp.date(2000, 1, 1));
      }

      // `.get('revoked', true)` falla en cerrado: si el campo faltara por lo
      // que sea, el enlace se considera revocado en vez de abierto.
      allow get: if request.auth != null
        || (resource.data.get('revoked', true) == false
            && notExpired()
            && assignmentStillValid());

      // Enumerar exige sesión; el invitado nunca puede listar la colección.
      allow list: if request.auth != null;

      // Crear: la caducidad la pone el cliente, así que el servidor le pone
      // un techo. Sin esto, un reloj adelantado (o un cliente manipulado)
      // creaba enlaces de vida prácticamente eterna.
      allow create: if request.auth != null
        && request.resource.data.revoked == false
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(100, 'd');

      // Actualizar: solo se permite ANULAR y refrescar el contenido. Antes
      // valía cualquier cambio, así que cualquier cuenta podía poner
      // `revoked: false`, estirar `expiresAt` y soltar `assignmentId` para
      // resucitar un enlace anulado y dejarlo vivo para siempre — es decir,
      // "anular" no anulaba nada frente a quien más motivos tenía para
      // saltárselo. Estos campos quedan congelados de por vida:
      allow update: if request.auth != null
        && request.resource.data.territoryId == resource.data.territoryId
        && request.resource.data.get('assignmentId', null) == resource.data.get('assignmentId', null)
        && request.resource.data.expiresAt == resource.data.expiresAt
        && request.resource.data.includes == resource.data.includes
        // `revoked` solo puede ir de false a true, nunca al revés.
        && (request.resource.data.revoked == resource.data.revoked
            || request.resource.data.revoked == true);

      allow delete: if request.auth != null;
    }

    // La clave del enlace, envuelta con la contraseña de la congregación.
    // Vive en una subcolección aparte y EXIGE SESIÓN, porque el documento de
    // arriba se lee sin autenticar: teniéndola allí, cualquiera que recibiera
    // un enlace obtenía un criptograma hecho con esa contraseña y cuyo texto
    // claro él ya conoce (su propia clave, que va en la URL). Eso permite
    // atacarla por fuerza bruta sin conexión, y esa contraseña abre TODO el
    // cifrado de la congregación.
    match /congregation/{congId}/territory_shares/{token}/secret/{docId} {
      allow read, write: if request.auth != null;
    }

    // ── Señal de sincronización casi-instantánea ──
    // Solo contiene nombres de tabla + timestamps de versión (cero datos,
    // el E2E sigue intacto). La escribe únicamente el backend con Admin SDK
    // (que ignora estas reglas); ningún cliente puede escribirla, así nadie
    // puede falsificar señales ni provocar tormentas de sync.
    match /congregation/{congId}/sync/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Colección para Trigger Email from Firestore ──
    match /mail/{id} {
      // Cualquier usuario autenticado puede enviar correos creando un documento
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
  }
}
